__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
# state.sh 的测试结果缓存**不在仓库里**，已挪到 ~/.cache/neko-dignity-guard/。
# 原因：neko_review_gate.js 的受控集是 readdir 全收、**不认 .gitignore**，
# 缓存只要留在仓库，每跑一次哈希就变 ⟹ 闸必红。所以缓存放仓库外，受控集里压根没有它。
.venv/
venv/
vendor/
dist/
build/
*.egg-info/
store.db
.env
.DS_Store

# 手工备份（本地留档用，不进仓库）
*.bak_*
*.bak
*.bak-*

# 闸的演练产物：drill 轮不构成放行依据，永不入库
# （review 轮的台账要入库 —— 那是审计记录，不是噪音）
docs/review/_gate_drill*
